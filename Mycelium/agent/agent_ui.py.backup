from pathlib import Path
from flask import Flask, render_template_string, redirect
import json
import subprocess
import sys

app = Flask(__name__)

BASE = Path(__file__).parent
DISCOVERY = BASE / "discovery.json"
AGENT = BASE / "agent.py"

HTML = """
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Mycelium Desktop Agent</title>
<style>
body {
    font-family: system-ui;
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
    background: #f7f7f7;
}
.card {
    background: white;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 15px;
    margin: 12px 0;
}
.path {
    font-family: monospace;
    word-break: break-all;
}
.badge {
    display:inline-block;
    padding:4px 8px;
    margin:3px;
    border-radius:6px;
    background:#eee;
}
button {
    padding:10px 18px;
    border:0;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}
</style>
</head>

<body>

<h1>🧠 Mycelium Desktop Agent</h1>

<p>
Computer: <b>{{ computer }}</b><br>
Projects gevonden: <b>{{ projects|length }}</b>
</p>

<form action="/scan" method="post">
    <button>🔄 Scan computer opnieuw</button>
</form>

{% for project in projects %}
<div class="card">
    <div class="path">{{ project.path }}</div>

    {% for t in project.types %}
        <span class="badge">{{ t }}</span>
    {% endfor %}

    {% if project.git %}
        <span class="badge">🟢 Git</span>
    {% endif %}
</div>
{% endfor %}

</body>
</html>
"""

def load_discovery():
    if not DISCOVERY.exists():
        return {"computer": "unknown", "projects": []}

    return json.loads(
        DISCOVERY.read_text(encoding="utf-8")
    )

@app.route("/")
def index():
    data = load_discovery()

    return render_template_string(
        HTML,
        computer=data.get("computer", "unknown"),
        projects=data.get("projects", [])
    )

@app.post("/scan")
def scan():
    subprocess.run(
        [sys.executable, str(AGENT)],
        check=True
    )

    return redirect("/")

if __name__ == "__main__":
    app.run(
        host="127.0.0.1",
        port=8787,
        debug=False
    )
