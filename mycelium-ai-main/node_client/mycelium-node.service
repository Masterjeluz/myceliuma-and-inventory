[Unit]
Description=Mycelium node (pull-only, user service)
# Copy this file to ~/.config/systemd/user/mycelium-node.service,
# adjust WorkingDirectory/ExecStart/node-id, put the node token in
# ~/.config/mycelium/node-token (chmod 600), then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now mycelium-node
#   systemctl --user status mycelium-node
# Stop: systemctl --user stop mycelium-node
# Logs: journalctl --user -u mycelium-node -f
# No inbound ports, no root required, pull-only.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mycelium-ai-main
Environment=MYCELIUM_NODE_TOKEN=%h/.config/mycelium/node-token
ExecStart=%h/mycelium-ai-main/.venv/bin/python -m node_client.main --coordinator http://127.0.0.1:8000 --node-id linux-laptop-1 --tier worker --capability node.status --capability inventory.read --poll-seconds 10
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
